# Copy to .env for local development. Never commit .env.
# Real environment variables (Docker, Railway, CI) override values in this file.

APP_ENV=local
LOG_LEVEL=INFO
# text for local reading, json for log platforms
LOG_FORMAT=text
# Set to false in production so internal error details are not returned to clients
EXPOSE_TECHNICAL_MESSAGES=true

# LLM provider: groq | azure | openai_compatible | none
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b
# For azure: LLM_BASE_URL=https://<resource>.openai.azure.com/ and LLM_MODEL=<deployment-name>
LLM_RETRY_ATTEMPTS=1

# Pluggable components
DOCUMENT_SOURCE=json
QUERY_LOG_STORE=jsonl

# Optional embeddings (pip install -r requirements-embeddings.txt)
EMBEDDINGS_ENABLED=true

# Relevance gate thresholds (tuned on the dev split of data/eval_questions.json)
MIN_TERM_COVERAGE_LLM=0.2
MIN_TERM_COVERAGE_EXTRACTIVE=0.6
MIN_COSINE=0.35
